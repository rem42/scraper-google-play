parameters:
    level: max
    paths:
        - src
    ignoreErrors:
        # Google Play responses are positional, untyped nested JSON arrays: every access is `mixed`.
        -
            identifiers:
                - offsetAccess.nonOffsetAccessible
                - assign.propertyType
                - foreach.nonIterable
                - argument.type
                - function.alreadyNarrowedType
            path: src/Api/*
